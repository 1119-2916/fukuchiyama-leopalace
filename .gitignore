# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# LoRA / model weights — distribute via GitHub Releases, not Git
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx

# Generated caption runs (regenerable; the adopted set is copied into
# the training dataset folder instead)
dataset-captions/

# Assembled trainer-ready datasets (copies of dataset/ images plus one
# chosen caption run; rebuild any time with assemble_training.py)
training-data/

# Normalized image runs (hygiene-processed copies of dataset/ images;
# rebuild any time with normalize_images.py)
dataset-normalized/

# Per-model preprocessed image runs (bucketed/cropped copies; rebuild
# any time with preprocess_images.py)
dataset-preprocessed/

# Training outputs and logs
outputs/
logs/
runs/
wandb/

# OS / editor
.DS_Store
.idea/
.vscode/
