# 本番構成（想定）:
#   RTX 6000 Blackwell Max-Q 上の vLLM で Qwen 3.8 27B FP8 を動かし、
#   LiteLLM プロキシが http://localhost:4000 で OpenAI 互換 API を開ける。
#   このスクリプトはそのマシン上で実行し、localhost:4000 に投げる想定。
#
# Copy to .env and fill in. caption_batch.py auto-loads .env
# (variables already exported in the shell take precedence).
# .env itself is gitignored -- never commit keys.

CAPTION_PROVIDER=openai-compatible

# LiteLLM が公開しているモデル名（LiteLLM の config で付けた alias を書く）
CAPTION_MODEL=

# LiteLLM proxy (OpenAI-compatible). Note the /v1 suffix.
CAPTION_BASE_URL=http://localhost:4000/v1

# LiteLLM 側で認証を有効にしている場合はそのキー（master key / virtual key）。
# 認証なしの場合は空でも動くことがあるが、その場合はダミーを入れてよい。
OPENAI_API_KEY=

# Trigger word prepended to every caption (leave empty until decided)
CAPTION_TRIGGER_WORD=okakikai

# 生成画像の Discord 投稿先 Webhook URL（post_generated.py 用）。
# URL 自体が認証情報なので、実際の値は .env のみに書くこと。
DISCORD_WEBHOOK_URL=

# --- クラウド API を使う場合の代替設定 ---
# OpenAI:      CAPTION_BASE_URL を空にし OPENAI_API_KEY と CAPTION_MODEL=gpt-4o 等
# Anthropic:   CAPTION_PROVIDER=anthropic, ANTHROPIC_API_KEY を設定
ANTHROPIC_API_KEY=
