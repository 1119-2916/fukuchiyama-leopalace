# Copy to .env and fill in. .env itself is gitignored -- never commit keys.
# (caption_batch.py reads the process environment, so `export` these or
#  load them with e.g. `set -a; source .env; set +a`.)

# Provider: openai-compatible | anthropic
CAPTION_PROVIDER=openai-compatible

# Model name for the provider (defaults exist; set explicitly to be safe)
# OpenAI example: gpt-4o-mini / gpt-4o
# Anthropic example: claude-sonnet-4-5
# Local (Ollama/vLLM) example: qwen2.5-vl, llava, etc.
CAPTION_MODEL=

# API key for the chosen provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Base URL override -- for a local OpenAI-compatible server, e.g.:
# CAPTION_BASE_URL=http://localhost:11434/v1   (Ollama)
# CAPTION_BASE_URL=http://localhost:8000/v1    (vLLM)
CAPTION_BASE_URL=

# Trigger word prepended to every caption (leave empty until decided)
CAPTION_TRIGGER_WORD=
